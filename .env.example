# No API keys are needed or allowed. Everything is local.
# The Ollama URL is fixed in app/llm_client.py to http://127.0.0.1:11434.
DEFAULT_MODEL=            # leave blank to auto-select by hardware
OLLAMA_TIMEOUT_SECONDS=120 # per local inference request; may be increased for slow hardware
DB_PATH=./data/harvey.db
HF_HUB_OFFLINE=1          # local embeddings never download model files
TRANSFORMERS_OFFLINE=1    # keep the Transformers loader offline too
OFFLINE_STRICT=1          # disable Hub telemetry and force model-cache-only loading
